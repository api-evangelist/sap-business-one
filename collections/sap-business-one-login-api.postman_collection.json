  "info": {
    "_postman_id": "9ce3a26b-2073-469a-bad1-06ac49ba692a",
    "name": "SAP Business One Service Layer BusinessPartners Login API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The SAP Business One Service Layer is an OData v4 (and legacy v3) REST\ninterface to a Business One company database. Clients authenticate via\nPOST /Login using company/user/password credentials and receive a\nB1SESSION cookie, then operate on entities (BusinessPartners, Items,\nOrders, Invoices, etc.) using standard OData verbs.\n\n\nContact Support:\n Name: SAP Business One",
      "type": "text/plain"
    }
  }
