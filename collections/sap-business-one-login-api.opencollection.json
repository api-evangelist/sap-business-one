{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Business One Service Layer BusinessPartners Login API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "B1SESSION",
      "value": "{{B1SESSION}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate and start a Service Layer session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}:{port}/b1s/v2/Login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a B1SESSION cookie used for subsequent requests."
        }
      ]
    }
  ],
  "bundled": true
}